# Server runs continuously; use persistent storage and one process.
PORT=3000
NODE_ENV=production
DATA_DIR=./server/data
DOMAIN=h00k.top
# Read-only cached formation export for the separate PHP paper bot; random 32+ chars.
# Leave empty to disable. Never put this secret in VITE_ variables or Git.
HOOK_PAPER_FEED_TOKEN=
# Change the existing background scanner timeframe without adding another scan job.
HOOK_SCREENER_TIMEFRAME=1h
# Optional provider shutdown, including while clarifying commercial permissions: binance,bybit
MARKET_DISABLED_EXCHANGES=
# Keep empty to use the project's existing Firebase Google sign-in callback.
# Set a custom domain only after registering its callback in the OAuth client.
FIREBASE_AUTH_DOMAIN_OVERRIDE=
FIREBASE_AUTH_HOST=knowledgeable-text-whh41.firebaseapp.com

# One site-wide Telegram bot. Users connect via a one-time /start link.
TELEGRAM_BOT_TOKEN=

# Optional: defaults to firebase-applet-config.json projectId.
FIREBASE_PROJECT_ID=

# Optional AI pattern analysis.
GEMINI_API_KEY=

# Local-account password recovery via emailed one-time links (Resend).
# Set in private VPS .env, NEVER in Git or client-side VITE_ vars.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=info@h00k.top
