# Never send VPS secrets, local account state or backups to Docker's build context.
.git
.git/**
node_modules
**/node_modules
dist
**/dist
coverage
**/coverage
.env
.env.*
**/.env
**/.env.*
!.env.example
server/data
server/data/**
*.dump
*.backup
*.bak
h00k-main*.zip
backup*.zip
*.backup.zip
*.log
npm-debug.log*
.test-*

# Repository-only sources: not needed for the h00k.top VPS image.
.github/
desktop/
docs/
tests/
metadata.json
*.save

# Local VPS secret handoff files (never copy into build stages)
bekenv
bekenv.*
**/bekenv
**/bekenv.*
